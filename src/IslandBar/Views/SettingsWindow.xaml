<Window x:Class="IslandBar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IslandBar Settings" Width="460" Height="640" MinWidth="400" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="#111113"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <!-- Section title -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,22,0,8"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <!-- On/off switch (a CheckBox that looks like a switch) -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" Cursor="Hand">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" TextBlock.FontSize="13"/>
                            <Border x:Name="Track" Grid.Column="1" Width="42" Height="24" CornerRadius="12"
                                    Background="#48484A" BorderThickness="2" BorderBrush="Transparent">
                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider pieces -->
        <Style x:Key="SliderEmptyPart" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SliderFilledPart" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
                <Border Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SliderKnob" TargetType="Thumb">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
                <Ellipse Fill="White" Stroke="#40000000" StrokeThickness="1"/>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#48484A" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFilledPart}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource SliderKnob}"/></Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmptyPart}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,12,24,24">
            <TextBlock Text="IslandBar" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Changes apply right away. Press Ctrl+Alt+I to open the island with the keyboard. Esc closes it."/>

            <TextBlock Style="{StaticResource SectionTitle}" Text="POSITION AND SIZE"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Monitor" FontSize="13" Margin="0,6,0,6"/>
                    <StackPanel x:Name="MonitorList" Margin="0,0,0,8"/>

                    <Grid Margin="0,6,0,0">
                        <TextBlock Text="Horizontal offset" FontSize="13"/>
                        <TextBlock x:Name="OffsetLabel" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    </Grid>
                    <Slider x:Name="OffsetSlider" Minimum="-800" Maximum="800" SmallChange="5" LargeChange="50" AutomationProperties.Name="Horizontal offset"/>

                    <Grid Margin="0,6,0,0">
                        <TextBlock Text="Distance from top" FontSize="13"/>
                        <TextBlock x:Name="TopLabel" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    </Grid>
                    <Slider x:Name="TopSlider" Minimum="0" Maximum="150" SmallChange="1" LargeChange="10" AutomationProperties.Name="Distance from top"/>

                    <Grid Margin="0,6,0,0">
                        <TextBlock Text="Size" FontSize="13"/>
                        <TextBlock x:Name="SizeLabel" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    </Grid>
                    <Slider x:Name="SizeSlider" Minimum="70" Maximum="150" SmallChange="5" LargeChange="10" AutomationProperties.Name="Size" Margin="0,0,0,8"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="ANIMATION"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Animation intensity" FontSize="13" Margin="0,6,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <RadioButton x:Name="AnimOff" Style="{StaticResource TabChip}" GroupName="Anim" Content="Off" Margin="0,0,4,0"/>
                        <RadioButton x:Name="AnimGentle" Style="{StaticResource TabChip}" GroupName="Anim" Content="Gentle" Margin="0,0,4,0"/>
                        <RadioButton x:Name="AnimNormal" Style="{StaticResource TabChip}" GroupName="Anim" Content="Normal" Margin="0,0,4,0"/>
                        <RadioButton x:Name="AnimPlayful" Style="{StaticResource TabChip}" GroupName="Anim" Content="Playful"/>
                    </StackPanel>
                    <CheckBox x:Name="FollowReducedMotion" Style="{StaticResource Toggle}" Content="Follow Windows &quot;Show animations&quot; setting"/>
                    <CheckBox x:Name="HoverPreview" Style="{StaticResource Toggle}" Content="Preview on hover"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="FEATURES"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="EnableMedia" Style="{StaticResource Toggle}" Content="Media controls"/>
                    <CheckBox x:Name="EnableVolume" Style="{StaticResource Toggle}" Content="Volume pop-up"/>
                    <CheckBox x:Name="EnableBattery" Style="{StaticResource Toggle}" Content="Battery"/>
                    <CheckBox x:Name="EnableTimer" Style="{StaticResource Toggle}" Content="Timer"/>
                    <CheckBox x:Name="TimerSound" Style="{StaticResource Toggle}" Content="Play a sound when the timer ends"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="WINDOW AND STARTUP"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="AlwaysOnTop" Style="{StaticResource Toggle}" Content="Always on top"/>
                    <CheckBox x:Name="HideInFullscreen" Style="{StaticResource Toggle}" Content="Hide during fullscreen apps and games"/>
                    <CheckBox x:Name="LaunchAtStartup" Style="{StaticResource Toggle}" Content="Start when I sign in to Windows"/>
                </StackPanel>
            </Border>

            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,18,0,0"
                       Text="Closing this window keeps IslandBar running. Use the tray icon to quit."/>
        </StackPanel>
    </ScrollViewer>
</Window>
