<UserControl x:Class="IslandBar.Views.EqualizerBars"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="18" Height="14" IsHitTestVisible="False">
    <!-- Three little bars that dance while music plays -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border x:Name="Bar1" Grid.Column="0" Background="{StaticResource AccentBrush}" CornerRadius="1.5" RenderTransformOrigin="0.5,1">
            <Border.RenderTransform><ScaleTransform ScaleY="0.4"/></Border.RenderTransform>
        </Border>
        <Border x:Name="Bar2" Grid.Column="2" Background="{StaticResource AccentBrush}" CornerRadius="1.5" RenderTransformOrigin="0.5,1">
            <Border.RenderTransform><ScaleTransform ScaleY="0.7"/></Border.RenderTransform>
        </Border>
        <Border x:Name="Bar3" Grid.Column="4" Background="{StaticResource AccentBrush}" CornerRadius="1.5" RenderTransformOrigin="0.5,1">
            <Border.RenderTransform><ScaleTransform ScaleY="0.5"/></Border.RenderTransform>
        </Border>
    </Grid>
</UserControl>
