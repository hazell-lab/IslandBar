<UserControl x:Class="IslandBar.Views.BatteryIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="28" Height="13" IsHitTestVisible="False">
    <Grid>
        <Border x:Name="Body" Width="24" HorizontalAlignment="Left" CornerRadius="3.5"
                BorderBrush="#99FFFFFF" BorderThickness="1.2"/>
        <Border Width="2.5" Height="5" HorizontalAlignment="Right" CornerRadius="0,1.5,1.5,0" Background="#99FFFFFF"/>
        <Border x:Name="Fill" Margin="2.2" Width="19" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource GreenBrush}"/>
    </Grid>
</UserControl>
